# Avaia Survey - Environment Variables Example
# Copy this file to .env and fill in with your values

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_ENDPOINT=http://localhost:3001/api/survey/submit

# Authentication
ADMIN_API_KEY=your_secret_admin_key_here

# Database (if using backend)
MONGODB_URI=
DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_KEY=

# Email Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SEND_FROM_EMAIL=survey@avaia.app

# Slack Integration (for notifications)
SLACK_WEBHOOK_URL=

# Analytics
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
SEGMENT_KEY=

# Third-party Services
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SENDGRID_API_KEY=

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SLACK_NOTIFICATIONS=false
ENABLE_EMAIL_VALIDATION=true
ENABLE_ANALYTICS=true

# Environment
SURVEY_TITLE=Avaia Survey
SURVEY_SUBTITLE=Help us understand your group travel expense challenges
ENVIRONMENT_NAME=production
